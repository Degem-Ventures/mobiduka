# Database connection examples. Replace every value before deployment.
DATABASE_URL="postgresql://user:password@localhost:5432/mobiduka?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/mobiduka"
PGHOST="localhost"
PGHOST_UNPOOLED="localhost"
PGUSER="mobiduka_user"
PGDATABASE="mobiduka"
PGPASSWORD="replace_with_local_password"
POSTGRES_URL="postgresql://user:password@localhost:5432/mobiduka?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:password@localhost:5432/mobiduka"
POSTGRES_USER="mobiduka_user"
POSTGRES_HOST="localhost"
POSTGRES_PASSWORD="replace_with_local_password"
POSTGRES_DATABASE="mobiduka"
POSTGRES_URL_NO_SSL="postgresql://user:password@localhost:5432/mobiduka"
POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/mobiduka?connect_timeout=15"

# Neon/Vercel integration metadata
NEON_AUTH_BASE_URL="https://your-neon-auth-host.example/neondb/auth"
NEON_PROJECT_ID="your-neon-project-id"
VITE_NEON_AUTH_URL="https://your-neon-auth-host.example/neondb/auth"
VERCEL_OIDC_TOKEN="replace_with_a_short_lived_vercel_oidc_token"

# DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET="replace_with_a_long_random_secret"

# Flutter web/mobile API origin. Pass this to Flutter with --dart-define.
MOBIDUKA_API_ORIGIN="https://mobiduka.vercel.app"
# MOBIDUKA_API_ORIGIN="https://stunning-space-acorn-967rrjjq75vxh7jgg-3000.app.github.dev"

# Safaricom Daraja configuration. Enter each business's Daraja credentials in
# Payment Methods; the server encrypts them and never returns them to clients.
# Generate once with: openssl rand -base64 32
MPESA_CREDENTIALS_ENCRYPTION_KEY="replace_with_a_32_byte_base64_key"
# Separate key for AES-256-GCM encryption of uploaded device backups.
# Generate once with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY="replace_with_a_different_32_byte_base64_key"
# Supported values: sandbox or production. This is server-only and cannot be
# selected by a tenant request.
MPESA_ENVIRONMENT="sandbox"
# Must be a publicly reachable HTTPS URL ending in /api/payments/mpesa-callback.
MPESA_CALLBACK_URL="https://your-public-tunnel.example/api/payments/mpesa-callback"

# Separate MobiDuka-owned Daraja account for subscription collections. Never
# reuse a tenant's POS credentials. Use the same environment as this Daraja app.
PLATFORM_MPESA_CONSUMER_KEY=""
PLATFORM_MPESA_CONSUMER_SECRET=""
PLATFORM_MPESA_SHORTCODE=""
PLATFORM_MPESA_PASSKEY=""
PLATFORM_MPESA_ACCOUNT_TYPE="PAYBILL"
PLATFORM_MPESA_PARTY_B=""
PLATFORM_MPESA_ENVIRONMENT="sandbox"
# Public HTTPS URL ending in /api/payments/platform-mpesa-callback.
PLATFORM_MPESA_CALLBACK_URL="https://your-domain.example/api/payments/platform-mpesa-callback"

# Firebase Cloud Messaging server alerts. Keep the private key in deployment secrets.
EXPENSE_ALERT_THRESHOLD_KES="5000"
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-firebase-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="replace_with_the_service_account_private_key"
# Android also needs android/app/google-services.json from this same Firebase project.
# iOS needs GoogleService-Info.plist and the Push Notifications capability in Xcode.

# Firebase Web Push public configuration (safe to expose to browser builds)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

NEXT_PUBLIC_SENTRY_DSN="https://sentry.io"
SENTRY_AUTH_TOKEN="replace_with_a_Sentry_auth_token"
SENTRY_ORG="mobiduka-pos"
SENTRY_PROJECT="mobiduka-nextjs-backend"
JWT_SECRET="mobiduka-dev-secret-change-me"

# Separate platform administrator credentials. Use a unique password with at
# least 16 characters; never reuse the example value in a deployed environment.
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="replace_with_a_unique_password_of_at_least_16_characters"

# Billing lifecycle cron (required in production). Configure the same secret
# for Vercel cron authorization. Email reminders are sent only when all email
# settings below are configured.
CRON_SECRET="replace_with_a_long_random_cron_secret"
RESEND_API_KEY=""
BILLING_EMAIL_FROM="MobiDuka Billing <billing@mobiduka.com>"
CONTACT_EMAIL_TO="owner@mobiduka.com"
# Optional; defaults to BILLING_EMAIL_FROM. Must be a verified Resend sender.
CONTACT_EMAIL_FROM=""

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Capacitor Android release signing. Keep production values in .env.local and
# GitHub Actions repository secrets; never expose these values in client builds.
ANDROID_KEYSTORE_PATH="mobiduka-release.jks"

ANDROID_KEYSTORE_BASE64="base64_encoded_release_keystore"
ANDROID_KEYSTORE_PASSWORD="replace_with_release_keystore_password"
ANDROID_KEY_ALIAS="mobiduka-release"
ANDROID_KEY_PASSWORD="replace_with_release_key_password"
