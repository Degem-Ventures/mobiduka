{
  "openapi": "3.0.3",
  "info": {
    "title": "MobiDuka Retail POS API Blueprint",
    "description": "Multi-tenant, offline-first production backend engine supporting Flutter mobile clients and Kenyan retail ecosystems (Cash tracking, M-Pesa records, local synchronization syncing).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Current app origin API router"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT issued by /auth/login. Use the token as Authorization: Bearer <token>."
      }
    }
  },
  "security": [
    { "bearerAuth": [] }
  ],
  "tags": [
    { "name": "Authentication", "description": "Owner and cashier login" },
    { "name": "Business", "description": "Tenant operations, cash, procurement, expenses, and reports" },
    { "name": "Employees", "description": "Staff directory and employee accounts" },
    { "name": "Customers", "description": "Customer profiles and credit ledger" },
    { "name": "Sales", "description": "Point-of-sale transactions" },
    { "name": "Inventory", "description": "Offline synchronization and stock changes" },
    { "name": "Payments", "description": "M-Pesa payment flows" }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Multi-Factor Authentication Entry Gateway",
        "description": "Handles standard credential authorization maps for owners and fast PIN code verification sequences for shift cashiers.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Use the owner password example or the cashier PIN example. Do not send password and pin together.",
                "properties": {
                  "identifier": { "type": "string" },
                  "password": { "type": "string" },
                  "pin": { "type": "string" }
                }
              },
              "examples": {
                "ownerPassword": {
                  "summary": "Seeded owner password login",
                  "value": { "identifier": "owner@mobiduka.com", "password": "OwnerPass123" }
                },
                "cashierPin": {
                  "summary": "Seeded cashier PIN login",
                  "value": { "identifier": "cashier1", "pin": "2540" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authentication successful, returns active JWT token parameters." },
          "401": { "description": "Invalid user credentials or mismatched secret keys." }
        }
      }
    },
    "/sync": {
      "post": {
        "tags": ["Inventory"],
        "summary": "Atomic Queue Transaction Sync Synchronization Endpoint",
        "description": "Processes a collection array of chronological state logs generated offline on the local device.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["businessId", "deviceId", "userId", "records"],
                "properties": {
                  "businessId": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e", "description": "Seeded deployed business ID. For another deployment, use businessId from the login response." },
                  "deviceId": { "type": "string", "example": "f9fe7e90-cff9-4e99-8335-d33eea68a8ec", "description": "Seeded device ID for Main Counter Tablet." },
                  "userId": { "type": "string", "format": "uuid", "example": "33d0457d-ecb4-4e60-a05a-223bae2541a4", "description": "Seeded deployed owner ID. For another deployment, use the authenticated user id from login." },
                  "records": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "example": "sync-product-001" },
                        "entityName": { "type": "string", "example": "Product" },
                        "operation": { "type": "string", "example": "UPDATE" },
                        "payload": {
                          "type": "object",
                          "example": {
                            "id": "c8d8215e-3868-4378-9a72-b6fa28f80c3a",
                            "name": "Safaricom Airtime 100 KES",
                            "sku": "SAF-100",
                            "barcode": "6191000000158",
                            "sellingPrice": 100
                          }
                        },
                        "createdAt": { "type": "string", "format": "date-time", "example": "2026-09-12T17:46:03.643Z" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Batch synced, returns processing counts and archived item arrays." },
          "500": { "description": "Atomic transaction database failure exception thrown." }
        }
      }
    },
    "/sales": {
      "post": {
        "tags": ["Sales"],
        "summary": "Process Sales Order Records",
        "description": "Locks an atomic order invoice ledger transaction string, records item histories, and automatically decreases shelf metrics.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "businessId": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e", "description": "Seeded deployed business ID. For another deployment, use businessId from the login response." },
                  "userId": { "type": "string", "format": "uuid", "example": "33d0457d-ecb4-4e60-a05a-223bae2541a4", "description": "Seeded deployed owner ID. For another deployment, use the authenticated user id from login." },
                  "invoiceNo": { "type": "string", "example": "INV-1001" },
                  "totalAmount": { "type": "number", "example": 100.0 },
                  "paymentMode": { "type": "string", "example": "CASH" },
                  "mpesaRef": { "type": "string", "example": "QX728HJ92K" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "example": {
                        "productId": "c8d8215e-3868-4378-9a72-b6fa28f80c3a",
                        "quantity": 1,
                        "unitPrice": 100,
                        "total": 100
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Sale created and stock adjustments complete." }
        }
      }
    },
    "/cash/session": {
      "post": {
        "tags": ["Business"],
        "summary": "Cashier Shift Drawer Reconciliation System",
        "description": "Triggers daily shift ignition sequences or processes shift totals with dynamic computed cash variances.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action", "businessId", "userId"],
                "properties": {
                  "action": { "type": "string", "example": "OPEN" },
                  "businessId": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e", "description": "Seeded deployed business ID. For another deployment, use businessId from the login response." },
                  "userId": { "type": "string", "format": "uuid", "example": "33d0457d-ecb4-4e60-a05a-223bae2541a4", "description": "Seeded deployed owner ID. For another deployment, use the authenticated user id from login." },
                  "sessionId": { "type": "string", "description": "For CLOSE, use the sessionId returned by the OPEN action." },
                  "openingCash": { "type": "number", "example": 5000.0 },
                  "closingCash": { "type": "number", "example": 14200.0 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Session closed out cleanly, returns computed float variances." },
          "201": { "description": "New open shift session generated." }
        }
      }
    },
    "/purchase-orders": {
      "post": {
        "tags": ["Business"],
        "summary": "Supply Chain & Restock Procurement System",
        "description": "Logs new wholesale distributor order sheets or automatically closes them out to increment store stock items.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action", "businessId"],
                "properties": {
                  "action": { "type": "string", "example": "CREATE" },
                  "businessId": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e", "description": "Seeded deployed business ID. For another deployment, use businessId from the login response." },
                  "orderId": { "type": "string", "description": "For RECEIVE, use the orderId returned by CREATE." },
                  "supplierId": { "type": "string", "format": "uuid", "example": "5a2e3b96-12e0-4921-a851-56117c975d96", "description": "Seeded deployed supplier ID for MobiDuka Distribution Hub." },
                  "orderNo": { "type": "string", "example": "PO-9002" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "example": {
                        "productId": "c8d8215e-3868-4378-9a72-b6fa28f80c3a",
                        "quantity": 12,
                        "costPrice": 92
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Order batch received and inventory stock level metrics updated." },
          "201": { "description": "Purchase order successfully created in REQUESTED state." }
        }
      }
    },
    "/customers/credit": {
      "post": {
        "tags": ["Customers"],
        "summary": "Customer Credit Ledger & Debt Book Tracking",
        "description": "Records credit charges generated during point-of-sale checkout or applies repayments to a customer's outstanding balance.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action", "businessId", "customerId", "amount"],
                "properties": {
                  "action": { "type": "string", "enum": ["CHARGE_CREDIT", "RECORD_PAYMENT"], "example": "RECORD_PAYMENT" },
                  "businessId": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e", "description": "Seeded deployed business ID. For another deployment, use businessId from the login response." },
                  "customerId": { "type": "string", "description": "Create a customer first, then use the returned customerId; the seed does not create customers." },
                  "amount": { "type": "number", "minimum": 0.01, "example": 1250.00 },
                  "dueDate": { "type": "string", "format": "date-time" },
                  "creditBookId": { "type": "string", "description": "Optional for CHARGE_CREDIT; the API generates this ID when omitted." },
                  "userId": { "type": "string", "format": "uuid", "example": "33d0457d-ecb4-4e60-a05a-223bae2541a4", "description": "Seeded deployed owner ID; use the authenticated user id for repayments." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Payment applied successfully and the outstanding balance returned." },
          "201": { "description": "New pending store credit debt logged under the customer account." },
          "400": { "description": "Invalid amount, unsupported action, or repayment exceeds the outstanding balance." },
          "404": { "description": "Customer was not found in the requested business." }
        }
      }
    },
    "/payments/stk-push": {
      "post": {
        "tags": ["Payments"],
        "summary": "Initiate Safaricom M-Pesa STK Push",
        "description": "Requests a customer PIN prompt through the Daraja sandbox and stores the pending checkout correlation record. Use the tenant ID returned by login; the seed generates business UUIDs at runtime.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["businessId", "phoneNumber", "amount"],
                "properties": {
                  "businessId": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e", "description": "Seeded deployed business ID. For another deployment, use businessId from the login response." },
                  "phoneNumber": { "type": "string", "pattern": "^(\\+?254|0)(1|7)[0-9]{8}$", "example": "254700000001", "description": "Seeded business phone in Kenyan format; replace with the customer's handset number for a real checkout." },
                  "amount": { "type": "number", "minimum": 1, "example": 1250 },
                  "accountReference": { "type": "string", "maxLength": 12, "example": "MobiDuka POS" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "STK request accepted by Safaricom." },
          "400": { "description": "Invalid business, phone number, or amount." },
          "404": { "description": "The supplied businessId does not belong to a known business tenant." },
          "502": { "description": "Safaricom rejected the STK request." }
        }
      }
    },
    "/payments/mpesa-callback": {
      "post": {
        "tags": ["Payments"],
        "summary": "Receive Safaricom M-Pesa Callback",
        "description": "Processes the asynchronous Daraja callback and records the transaction result and receipt number.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["Body"],
                "properties": {
                  "Body": { "type": "object", "description": "Safaricom stkCallback envelope." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Callback acknowledged and transaction status recorded." }
        }
      }
    },
    "/payments/stk-query": {
      "post": {
        "tags": ["Payments"],
        "summary": "Query M-Pesa STK Transaction Status",
        "description": "Checks the webhook cache first, then queries Safaricom for a pending STK transaction until it completes or fails.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["checkoutRequestId"],
                "properties": {
                  "checkoutRequestId": { "type": "string", "description": "Use checkoutRequestId returned by /payments/stk-push or persisted by the M-Pesa callback." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Returns SUCCESS, PENDING, CANCELLED, or FAILED." },
          "404": { "description": "Transaction correlation record was not found." }
        }
      }
    },
    "/customers": {
      "get": {
        "tags": ["Customers"],
        "summary": "Query or Search Registered Customer Profiles",
        "description": "Returns customers for a tenant, optionally filtered by name or phone number. The query filter is case-insensitive.",
        "parameters": [
          { "name": "businessId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e" }, "description": "Seeded deployed business ID." },
          { "name": "query", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Case-insensitive name or phone search." }
        ],
        "responses": {
          "200": { "description": "Customer profiles returned successfully." },
          "400": { "description": "businessId is missing." }
        }
      },
      "post": {
        "tags": ["Customers"],
        "summary": "Register or Update Customer Profile",
        "description": "Creates or updates a customer and ensures an associated CreditAccount exists.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["businessId", "name"],
                "properties": {
                  "id": { "type": "string" },
                  "businessId": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e" },
                  "name": { "type": "string", "example": "Wanjiku Njoroge" },
                  "phone": { "type": "string", "example": "0722000111" },
                  "initialCreditLimit": { "type": "number", "minimum": 0, "example": 5000 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Customer profile registered successfully." },
          "400": { "description": "Invalid profile data or duplicate phone number." }
        }
      }
    },
    "/dashboard/summary": {
      "get": {
        "tags": ["Business"],
        "summary": "Aggregate dashboard summary for a tenant",
        "description": "Returns the dashboard metrics used by the web app and Flutter dashboards, including revenue, cash, low stock, recent sales, and scan activity for the seeded tenant.",
        "parameters": [
          { "name": "businessId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e" }, "description": "Seeded deployed business ID from the demo tenant." },
          { "name": "days", "in": "query", "required": false, "schema": { "type": "integer", "default": 30, "example": 30 }, "description": "Backward look window in days. Defaults to 30." }
        ],
        "responses": {
          "200": {
            "description": "Dashboard summary assembled from real sales, expenses, cash sessions, inventory, and scan events.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "metadata": {
                      "type": "object",
                      "properties": {
                        "businessId": { "type": "string", "example": "0e722844-15f4-4807-8a69-9614e448f21e" },
                        "name": { "type": "string", "example": "MobiDuka Wholesale Eldoret" },
                        "country": { "type": "string", "example": "Kenya" },
                        "currency": { "type": "string", "example": "KES" },
                        "timezone": { "type": "string", "example": "Africa/Nairobi" },
                        "date": { "type": "string", "example": "2026-09-18" }
                      }
                    },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "todayRevenue": { "type": "number", "example": 84250 },
                        "todayProfit": { "type": "number", "example": 61210 },
                        "todayTransactionCount": { "type": "integer", "example": 18 },
                        "periodRevenue": { "type": "number", "example": 524850 },
                        "periodProfit": { "type": "number", "example": 318172 },
                        "profitMarginPercentage": { "type": "number", "example": 60.6 },
                        "cashInTill": { "type": "number", "example": 28200 },
                        "creditOut": { "type": "number", "example": 15250 },
                        "creditCustomerCount": { "type": "integer", "example": 6 },
                        "inventoryValue": { "type": "number", "example": 64250 },
                        "activeSkuCount": { "type": "integer", "example": 15 },
                        "lowStockCount": { "type": "integer", "example": 3 }
                      }
                    },
                    "paymentBreakdown": {
                      "type": "object",
                      "additionalProperties": { "type": "object", "properties": { "amount": { "type": "number" }, "transactions": { "type": "integer" } } }
                    },
                    "topProducts": { "type": "array", "items": { "type": "object" } },
                    "recentTransactions": { "type": "array", "items": { "type": "object" } },
                    "lowStockItems": { "type": "array", "items": { "type": "object" } },
                    "cashSessions": { "type": "array", "items": { "type": "object" } },
                    "scanActivity": { "type": "object", "properties": { "counts": { "type": "object" }, "recent": { "type": "array" } } }
                  }
                }
              }
            }
          },
          "401": { "description": "Authenticated business context is required." },
          "404": { "description": "Business not found." },
          "500": { "description": "Failed to assemble dashboard data." }
        }
      }
    },
    "/scans": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Look up a product by barcode and record scan activity",
        "description": "Returns product details for a scanned barcode and logs the event for the authenticated tenant. The seeded demo catalog includes printer-friendly barcodes such as 6191000000158 for Safaricom Airtime 100 KES.",
        "parameters": [
          { "name": "businessId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e" }, "description": "Authenticated business tenant ID." },
          { "name": "barcode", "in": "query", "required": true, "schema": { "type": "string", "example": "6191000000158" }, "description": "Barcode to lookup in the store catalog." }
        ],
        "responses": {
          "200": {
            "description": "Lookup completed and scan logged.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "found": { "type": "boolean", "example": true },
                    "status": { "type": "string", "example": "FOUND" },
                    "product": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "example": "c8d8215e-3868-4378-9a72-b6fa28f80c3a" },
                        "name": { "type": "string", "example": "Safaricom Airtime 100 KES" },
                        "barcode": { "type": "string", "example": "6191000000158" },
                        "category": { "type": "string", "example": "Fast Moving Consumer Goods" },
                        "price": { "type": "number", "example": 100 },
                        "stock": { "type": "integer", "example": 250 },
                        "minimumStock": { "type": "integer", "example": 20 },
                        "stockStatus": { "type": "string", "example": "GOOD" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Authenticated business and barcode are required." },
          "500": { "description": "Failed to look up scanned product." }
        }
      },
      "post": {
        "tags": ["Inventory"],
        "summary": "Process scan actions for lookup, add-to-cart, and restock",
        "description": "Allows clients to look up a product, add it to a cart, or add inventory through a barcode-driven restock action. The demo tenant includes owner and cashier accounts like owner@mobiduka.com / OwnerPass123 and cashier1 / 2540.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["businessId", "barcode"],
                "properties": {
                  "businessId": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e" },
                  "barcode": { "type": "string", "example": "6191000000158" },
                  "statusOverride": { "type": "string", "enum": ["AUTO", "MANUAL"], "example": "AUTO" },
                  "action": { "type": "string", "enum": ["LOOKUP", "ADD_TO_CART", "RESTOCK"], "example": "RESTOCK" },
                  "userId": { "type": "string", "format": "uuid", "example": "33d0457d-ecb4-4e60-a05a-223bae2541a4" },
                  "quantity": { "type": "integer", "minimum": 1, "example": 12 },
                  "reason": { "type": "string", "example": "Scan restock from POS" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Restock completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "action": { "type": "string", "example": "RESTOCK" },
                    "scanId": { "type": "string", "example": "cmg9a0g7q0000l6txk4j7f4r8" },
                    "product": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "example": "c8d8215e-3868-4378-9a72-b6fa28f80c3a" },
                        "name": { "type": "string", "example": "Safaricom Airtime 100 KES" },
                        "barcode": { "type": "string", "example": "6191000000158" },
                        "stock": { "type": "integer", "example": 262 },
                        "reservedStock": { "type": "integer", "example": 0 },
                        "minimumStock": { "type": "integer", "example": 20 },
                        "stockStatus": { "type": "string", "example": "GOOD" }
                      }
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Lookup or add-to-cart action completed and the scan event was persisted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "action": { "type": "string", "example": "ADD_TO_CART" },
                    "scanId": { "type": "string" },
                    "status": { "type": "string", "example": "FOUND" },
                    "product": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "barcode": { "type": "string" }, "price": { "type": "number" }, "stock": { "type": "integer" }, "stockStatus": { "type": "string" } } }
                  }
                }
              }
            }
          },
          "400": { "description": "Malformed payload or invalid action/status combination." },
          "403": { "description": "User does not belong to the authenticated business." },
          "404": { "description": "Unknown barcode for a restock request." },
          "500": { "description": "Failed to persist scan event." }
        }
      }
    },
    "/reports/summary": {
      "get": {
        "tags": ["Business"],
        "summary": "Tenant Analytical Sales and Profit Summary",
        "description": "Returns tenant-scoped revenue, cost, expense, profit, inventory valuation, low-stock, open-shift, and daily trend metrics.",
        "parameters": [
          { "name": "businessId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e" }, "description": "Seeded deployed business ID." },
          { "name": "days", "in": "query", "required": false, "schema": { "type": "integer", "enum": [7, 30, 90], "default": 7 }, "description": "Trend window in days." }
        ],
        "responses": {
          "200": {
            "description": "Analytical summary and chronological daily trend frames returned.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "totalRevenue": { "type": "number" },
                        "totalCostOfGoods": { "type": "number" },
                        "totalExpenses": { "type": "number" },
                        "netProfit": { "type": "number" },
                        "profitMarginPercentage": { "type": "string" },
                        "lowStockAlertsCount": { "type": "integer" },
                        "inventoryValuation": { "type": "number" },
                        "inventoryUnits": { "type": "integer" },
                        "activeOpenShiftsCount": { "type": "integer" },
                        "openingCashTotal": { "type": "number" }
                      }
                    },
                    "trends": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          },
          "400": { "description": "businessId is missing." },
          "500": { "description": "Analytical aggregation failed." }
        }
      }
    },
    "/employees": {
      "get": {
        "tags": ["Employees"],
        "summary": "Retrieve Multi-Tenant Staff Directory Roster",
        "parameters": [{ "name": "businessId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e" } }],
        "responses": {
          "200": { "description": "Roster array generated successfully." },
          "400": { "description": "businessId is missing." }
        }
      },
      "post": {
        "tags": ["Employees"],
        "summary": "Provision or Update a Staff Employee Account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["businessId", "name", "role"],
                "properties": {
                  "id": { "type": "string" },
                  "businessId": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e" },
                  "name": { "type": "string", "example": "Kamau Mwangi" },
                  "email": { "type": "string", "format": "email" },
                  "phone": { "type": "string" },
                  "role": { "type": "string", "enum": ["OWNER", "MANAGER", "CASHIER"] },
                  "pin": { "type": "string", "example": "2541" },
                  "isActive": { "type": "boolean", "default": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Staff employee profile saved." },
          "400": { "description": "Invalid role, tenant, or employee configuration." }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Authentication", "Employees"],
        "summary": "Register a user inside the authenticated business",
        "description": "Creates an active owner, manager, cashier, supervisor, or accountant account. The business is taken from the bearer token; client businessId values are not accepted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "role"],
                "properties": {
                  "name": { "type": "string", "example": "Kamau Mwangi" },
                  "email": { "type": "string", "format": "email", "example": "kamau@mobiduka.com" },
                  "username": { "type": "string", "example": "kamau" },
                  "phone": { "type": "string", "example": "+254700000002" },
                  "role": { "type": "string", "enum": ["ADMIN", "OWNER", "SUPERVISOR", "CASHIER", "ACCOUNTANT"], "example": "CASHIER" },
                  "pin": { "type": "string", "pattern": "^[0-9]{4}$", "example": "2542" },
                  "password": { "type": "string", "format": "password", "example": "ChangeMe123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered successfully." },
          "400": { "description": "Invalid user registration data." },
          "401": { "description": "Authenticated business context is required." },
          "409": { "description": "Email or username is already registered." }
        }
      }
    },
    "/notifications": {
      "get": {
        "tags": ["Business"],
        "summary": "Fetch low-stock notifications",
        "parameters": [{ "name": "businessId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Notifications returned." }, "401": { "description": "Authenticated business context is required." } }
      }
    },
    "/products": {
      "get": {
        "tags": ["Inventory"],
        "summary": "List products and inventory for a business",
        "parameters": [{ "name": "businessId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Product catalog returned." }, "401": { "description": "Authenticated business context is required." } }
      },
      "post": {
        "tags": ["Inventory"],
        "summary": "Create a product",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "businessId": { "type": "string", "format": "uuid" }, "name": { "type": "string" }, "sellingPrice": { "type": "number" }, "costPrice": { "type": "number" }, "sku": { "type": "string" }, "barcode": { "type": "string" }, "trackStock": { "type": "boolean" } } } } } },
        "responses": { "201": { "description": "Product created." }, "401": { "description": "Authenticated business context is required." }, "400": { "description": "Product creation failed." } }
      }
    },
    "/expenses": {
      "get": {
        "tags": ["Business"],
        "summary": "Fetch Store Expense Ledger History",
        "description": "Returns tenant-scoped operational outflows ordered from newest to oldest.",
        "parameters": [
          { "name": "businessId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e" } }
        ],
        "responses": {
          "200": { "description": "Expense records fetched successfully." },
          "400": { "description": "businessId is missing." }
        }
      },
      "post": {
        "tags": ["Business"],
        "summary": "Log a New Cash or M-Pesa Store Outflow",
        "description": "Creates an expense record and an associated audit entry for the tenant user.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["businessId", "userId", "category", "amount", "description"],
                "properties": {
                  "id": { "type": "string" },
                  "businessId": { "type": "string", "format": "uuid", "example": "0e722844-15f4-4807-8a69-9614e448f21e" },
                  "userId": { "type": "string", "format": "uuid", "example": "33d0457d-ecb4-4e60-a05a-223bae2541a4" },
                  "category": { "type": "string", "example": "RENT" },
                  "amount": { "type": "number", "minimum": 0.01, "example": 15000 },
                  "description": { "type": "string", "example": "September shop rent payment" },
                  "paidTo": { "type": "string", "example": "Landlord" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Expense logged successfully." },
          "400": { "description": "Invalid expense data." },
          "404": { "description": "User was not found in the requested business." }
        }
      }
    }
  }
}
